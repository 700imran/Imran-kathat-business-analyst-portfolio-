<mxfile host="app.diagrams.net"><diagram name="Mizan - As-Is Reconciliation Process (BPMN 2.0, manual)" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="560"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="Mizan - As-Is Reconciliation Process (BPMN 2.0, manual)" style="text;html=1;fontStyle=1;fontSize=15;fontColor=#1F3A5F;align=left;" vertex="1" parent="1"><mxGeometry x="14" y="4" width="600" height="26" as="geometry"/></mxCell><mxCell id="l3" value="Finance Analyst" style="swimlane;horizontal=0;startSize=26;fillColor=#FAFAFA;swimlaneFillColor=#FAFAFA;fontStyle=1;fontColor=#1F3A5F;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="1500" height="190" as="geometry"/></mxCell><mxCell id="l4" value="Finance Manager" style="swimlane;horizontal=0;startSize=26;fillColor=#FAFAFA;swimlaneFillColor=#FAFAFA;fontStyle=1;fontColor=#1F3A5F;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="0" y="230" width="1500" height="130" as="geometry"/></mxCell><mxCell id="l5" value="Portals" style="swimlane;horizontal=0;startSize=26;fillColor=#FAFAFA;swimlaneFillColor=#FAFAFA;fontStyle=1;fontColor=#1F3A5F;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="0" y="360" width="1500" height="90" as="geometry"/></mxCell><mxCell id="l6" value="ERP (Ledger)" style="swimlane;horizontal=0;startSize=26;fillColor=#FAFAFA;swimlaneFillColor=#FAFAFA;fontStyle=1;fontColor=#1F3A5F;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="0" y="450" width="1500" height="100" as="geometry"/></mxCell><mxCell id="s" value="Daily 09:00&#xa;GST" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontColor=#222222;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="54" height="54" as="geometry"/></mxCell><mxCell id="t1" value="H1: Log in to gateway&#xa;and bank portals,&#xa;download CSV / MT940" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor